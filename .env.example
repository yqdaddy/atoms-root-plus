# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# LLM API 配置
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-3.0-flash

# 认证配置（会话 pepper；生产必须替换为强随机值）
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# Cookie Secure 标记（HTTPS 部署时设为 true）
COOKIE_SECURE=false

# 服务端口（可选，默认 3000）
PORT=3000

# 运行环境（可选，默认 development）
NODE_ENV=development

# 低内存模式：跳过审查阶段以节省内存（设为 true 启用）
# SKIP_REVIEW=true
# 部署目录：生成项目静态文件的写入位置（Nginx alias 指向此处）
DEPLOY_DIR=/var/www/atoms-projects

# 部署 URL 前缀：需与 Nginx 的 location 配置对应（也可填完整域名如 https://your-domain.com/projects）
DEPLOY_BASE_URL=/projects
